<?xml version="1.0" encoding="utf-8"?>
<!--
    Motorola Razr 60 Ultra stock /product/etc/fonts_customization.xml
    extended with Omarchnix / nixos-config personal fonts:
      - IBM Plex Sans (`IBMPlexSans`)
      - Michelangelus (`Michelangelus`)
      - Lilex (`Lilex`)
-->
<fonts-modification version="1">
    <family name="Exo2-Regular" customizationType="new-named-family">
        <font weight="400" style="normal" postScriptName="Exo2-Regular">
            Exo2-Regular.ttf
        </font>
        <font weight="500" style="normal" postScriptName="Exo2-Medium">
            Exo2-Medium.ttf
        </font>
        <font weight="400" style="italic" postScriptName="Exo2-Italic">
            Exo2-Italic.ttf
        </font>
    </family>
    <family name="Exo2-Stacked" customizationType="new-named-family">
        <font weight="400" style="normal" postScriptName="Exo2Stacked-Regular">
            Exo2Stacked-Regular.ttf
        </font>
        <font weight="500" style="normal" postScriptName="Exo2Stacked-Medium">
            Exo2Stacked-Medium.ttf
        </font>
    </family>
    <family name="NotoSansSC" customizationType="new-named-family">
        <font weight="100" style="normal" postScriptName="NotoSansSC-Thin">
            NotoSansSC-Thin.otf
        </font>
